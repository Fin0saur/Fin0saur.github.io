<%
const allCategories = typeof site.categories.toArray === 'function'
  ? site.categories.toArray()
  : (site.categories?.data || []);

const toPostsArray = (postsQuery) => {
  if (!postsQuery) return [];
  if (typeof postsQuery.toArray === 'function') return postsQuery.toArray();
  return postsQuery.data || [];
};

const sortPostsByDate = (posts) =>
  posts.slice().sort((a, b) => new Date(b.date) - new Date(a.date));

const compareNodes = (left, right) => {
  if (left.depth !== right.depth) return left.depth - right.depth;
  if (right.category.length !== left.category.length) return right.category.length - left.category.length;
  return left.category.name.localeCompare(right.category.name, 'zh-CN');
};

const categoryMap = new Map();
const nodes = allCategories.map((category) => {
  const posts = sortPostsByDate(toPostsArray(category.posts));
  const node = {
    category,
    posts,
    latestPost: posts[0] || null,
    children: [],
    depth: 0,
    lineage: [category.name],
  };

  categoryMap.set(category._id, node);
  return node;
});

nodes.forEach((node) => {
  if (!node.category.parent) return;

  const parentNode = categoryMap.get(node.category.parent);
  if (parentNode) {
    parentNode.children.push(node);
  }
});

const roots = nodes.filter((node) => !node.category.parent || !categoryMap.has(node.category.parent));

const hydrateNode = (node, lineage = []) => {
  node.depth = lineage.length;
  node.lineage = lineage.concat(node.category.name);
  node.children.sort(compareNodes);
  node.children.forEach((child) => hydrateNode(child, node.lineage));
};

roots.sort(compareNodes);
roots.forEach((root) => hydrateNode(root));

const totalPosts = site.posts.length;
%>

