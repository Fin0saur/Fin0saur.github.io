<%
const allCategories = typeof site.categories.toArray === 'function'
  ? site.categories.toArray()
  : (site.categories?.data || []);

const categoryMap = new Map();
allCategories.forEach((category) => categoryMap.set(category._id, category));

const currentCategory = allCategories.find((category) => {
  return page.path === `${category.path}index.html` || page.base === category.path || page.path === category.path;
}) || null;

const getLineage = (category) => {
  if (!category) return page.category ? [page.category] : [];

  const lineage = [category.name];
  let cursor = category;

  while (cursor.parent) {
    const parent = categoryMap.get(cursor.parent);
    if (!parent) break;
    lineage.unshift(parent.name);
    cursor = parent;
  }

  return lineage;
};

const childCategories = currentCategory
  ? allCategories
      .filter((category) => category.parent === currentCategory._id)
      .sort((left, right) => {
        if (right.length !== left.length) return right.length - left.length;
        return left.name.localeCompare(right.name, 'zh-CN');
      })
  : [];

const lineage = getLineage(currentCategory);
%>

<style>
  .category-detail-shell {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .category-detail-hero {
    padding: 24px 26px;
    border: 1px solid var(--border-color);
    border-radius: 24px;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--second-background-color) 92%, white 8%), var(--background-color));
    box-shadow: var(--redefine-box-shadow-flat);
  }

  .category-detail-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--primary-color);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .category-detail-back:hover {
    text-decoration: underline;
  }

  .category-detail-label {
    margin: 0 0 10px;
    color: var(--third-text-color);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-detail-title {
    margin: 0;
    color: var(--second-text-color);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .category-detail-path {
    margin: 12px 0 0;
    color: var(--third-text-color);
    font-size: 0.98rem;
    line-height: 1.9;
  }

  .category-detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .category-detail-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: var(--background-color);
    border: 1px solid var(--border-color);
    color: var(--third-text-color);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .category-detail-pill strong {
    color: var(--second-text-color);
    font-weight: 700;
  }

  .category-detail-children {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .category-detail-child-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--primary-color) 10%, var(--background-color) 90%);
    color: var(--primary-color);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .category-detail-child-link:hover {
    transform: translateY(-1px);
    box-shadow: var(--redefine-box-shadow-flat);
  }

  .category-detail-list {
    padding: 24px 26px;
    border: 1px solid var(--border-color);
    border-radius: 24px;
    background: var(--background-color);
    box-shadow: var(--redefine-box-shadow-flat);
  }

  .category-detail-list .archive-item:last-child {
    margin-bottom: 0;
  }

  .category-detail-list .archive-item-header {
    margin-bottom: 10px;
  }

  .category-detail-list .archive-year {
    color: var(--second-text-color);
  }

  .category-detail-list .article-list {
    margin: 0;
  }

  .category-detail-list .article-item {
    padding-left: 26px;
    border-left-color: color-mix(in srgb, var(--primary-color) 22%, var(--border-color) 78%);
  }

  .category-detail-list .article-title {
    color: var(--second-text-color);
    font-size: clamp(1.15rem, 2.3vw, 1.5rem);
    line-height: 1.5;
    transition: color 0.2s ease;
  }

  .category-detail-list a:hover .article-title {
    color: var(--primary-color);
  }

  @media (max-width: 640px) {
    .category-detail-hero,
    .category-detail-list {
      padding: 20px;
    }

    .category-detail-list .article-item {
      padding-left: 18px;
    }
  }
</style>

<section class="category-detail-shell">
  <header class="category-detail-hero">
    <a class="category-detail-back" href="<%= url_for('/categories/') %>">
      <i class="fa-solid fa-arrow-left-long"></i>
      返回分类总览
    </a>

    <p class="category-detail-label">Category Detail</p>
    <h1 class="category-detail-title"><%= currentCategory ? currentCategory.name : page.category %></h1>
    <p class="category-detail-path"><%= lineage.join(' / ') %></p>

    <div class="category-detail-meta">
      <span class="category-detail-pill">
        <i class="fa-regular fa-file-lines"></i>
        文章 <strong><%= page.posts.length %></strong>
      </span>
      <span class="category-detail-pill">
        <i class="fa-solid fa-layer-group"></i>
        层级 <strong><%= Math.max(lineage.length, 1) %></strong>
      </span>
      <% if (childCategories.length > 0) { %>
        <span class="category-detail-pill">
          <i class="fa-solid fa-sitemap"></i>
          下级分类 <strong><%= childCategories.length %></strong>
        </span>
      <% } %>
    </div>

    <% if (childCategories.length > 0) { %>
      <div class="category-detail-children">
        <% childCategories.forEach((childCategory) => { %>
          <a class="category-detail-child-link" href="<%= url_for(childCategory.path) %>">
            <i class="fa-solid fa-folder"></i>
            <span><%= childCategory.name %> · <%= childCategory.length %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </header>

  <div class="category-detail-list">
    <%- partial('utils/posts-list', { posts: page.posts }) %>
  </div>
</section>
