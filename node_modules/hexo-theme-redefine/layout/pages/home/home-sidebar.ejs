<div class="home-sidebar-container">
    <div class="sticky-container sticky">
        <%
            const hasSidebarLinks = theme.home.sidebar.links !== null;
            const hasSidebarAnnouncement = theme.home.sidebar.announcement !== null;
        %>
        <% if (theme.home.sidebar.first_item === "info") { %>
            <div class="sidebar-content">
                <%- partial("components/sidebar/avatar") %>
                <%- partial("components/sidebar/author") %>
                <%- partial('components/sidebar/statistics')%>
            </div>
            <% if (hasSidebarLinks || hasSidebarAnnouncement) {%>
                <div class="sidebar-links"  <% if (hasSidebarLinks || hasSidebarAnnouncement) { %> marginTop <% } %>>
                    <div class="site-info">
                        <div class="site-name"><%= theme.info.title || config.title %></div>
                        <% if (hasSidebarAnnouncement && hasSidebarLinks) { %>
                            <div class="announcement">
                                <%- theme.home.sidebar.announcement %>
                            </div>
                        <% } %>
                    </div>
                    <% if (hasSidebarLinks) {%>
                        <% for (let i in theme.home.sidebar.links) { %>
                            <% if (theme.home.sidebar.links[i].path === 'none') {} else {%>
                                <a class="links" href="<%= url_for(theme.home.sidebar.links[i].path) %>">
                                    <% if (theme.home.sidebar.links[i].icon) { %>
                                        <i class="<%- theme.home.sidebar.links[i].icon %> icon-space"></i>
                                    <% } %>
                                    <span class="link-name"><%= __(i) %></span>
                                </a>
                            <% } %>
                        <% } %>
                    <% } else {%>
                        <div class="announcement-outside">
                            <%- theme.home.sidebar.announcement %>
                        </div>
                    <% } %>
                </div>
            <% } %>
        <% } else { %>
            <% if (hasSidebarLinks || hasSidebarAnnouncement) {%>
                <div class="sidebar-links">
                    <div class="site-info">
                        <div class="site-name"><%= theme.info.title || config.title %></div>
                        <% if (hasSidebarAnnouncement && hasSidebarLinks) { %>
                            <div class="announcement">
                                <%- theme.home.sidebar.announcement %>
                            </div>
                        <% } %>
                    </div>
                    <% if (hasSidebarLinks) {%>
                        <% for (let i in theme.home.sidebar.links) { %>
                            <% if (theme.home.sidebar.links[i].path === 'none') {} else {%>
                                <a class="links" href="<%= url_for(theme.home.sidebar.links[i].path) %>">
                                    <% if (theme.home.sidebar.links[i].icon) { %>
                                        <i class="<%- theme.home.sidebar.links[i].icon %> icon-space"></i>
                                    <% } %>
                                    <span class="link-name"><%= __(i) %></span>
                                </a>
                            <% } %>
                        <% } %>
                    <% } else {%>
                        <div class="announcement-outside">
                            <%- theme.home.sidebar.announcement %>
                        </div>
                    <% } %>
                </div>
            <% } %>
            <div class="sidebar-content" <% if (hasSidebarLinks || hasSidebarAnnouncement) { %> marginTop <% } %>>
                <%- partial("components/sidebar/avatar") %>
                <%- partial("components/sidebar/author") %>
                <%- partial('components/sidebar/statistics')%>
            </div>
        <% } %>

        <!-- Custom Categories Section -->
        <% if (theme.home.sidebar.show_categories === true) { %>
        <div class="sidebar-categories" style="margin-top: 20px; padding: 0 10px;">
            <h4 style="font-size: 14px; font-weight: bold; margin-bottom: 10px; color: #666;">分类</h4>
            <div style="display: flex; flex-direction: column; gap: 6px;">
                <% site.categories.each(function(category) { %>
                <a href="<%= url_for(category.path) %>" style="display: flex; justify-content: space-between; align-items: center; color: #A31F34; font-size: 13px;">
                    <span><i class="fa-regular fa-folder" style="margin-right: 6px;"></i><%= category.name %></span>
                    <span style="color: #999; font-size: 12px;">(<%= category.posts.length %>)</span>
                </a>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- Custom Contact Section -->
        <% if (theme.home.sidebar.show_contact === true) { %>
        <div class="sidebar-contact" style="margin-top: 20px; padding: 0 10px;">
            <h4 style="font-size: 14px; font-weight: bold; margin-bottom: 10px; color: #666;">联系方式</h4>
            <div style="display: flex; flex-direction: column; gap: 6px;">
                <% if (theme.home.sidebar.contact.github) { %>
                <a href="<%= theme.home.sidebar.contact.github %>" style="color: #A31F34; font-size: 13px;">
                    <i class="fa-brands fa-github" style="margin-right: 6px;"></i>GitHub
                </a>
                <% } %>
                <% if (theme.home.sidebar.contact.email) { %>
                <a href="mailto:<%= theme.home.sidebar.contact.email %>" style="color: #A31F34; font-size: 13px;">
                    <i class="fa-regular fa-envelope" style="margin-right: 6px;"></i>邮箱
                </a>
                <% } %>
                <% if (theme.home.sidebar.contact.bilibili) { %>
                <a href="<%= theme.home.sidebar.contact.bilibili %>" style="color: #A31F34; font-size: 13px;">
                    <i class="fa-brands fa-bilibili" style="margin-right: 6px;"></i>B站
                </a>
                <% } %>
            </div>
        </div>
        <% } %>

    </div>
</div>
